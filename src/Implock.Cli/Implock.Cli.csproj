<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>implock</AssemblyName>
    <RootNamespace>Implock.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>implock</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Implock.Cli</PackageId>
    <Description>Generate, check and report on implement.lock: model-written method bodies kept in a reviewed lock file.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <ProjectReference Include="../Implock.Generator/Implock.Generator.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Implock.Cli.Tests" />
  </ItemGroup>

</Project>
